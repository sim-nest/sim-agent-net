graph:
topology roadmap/refiner-v1
node in verb=in output=roadmap/RefinerFrame
node receive verb=call target=roadmap.step/receive
node inspect verb=call target=roadmap.step/inspect
node propose verb=call target=roadmap.step/propose role=runner
node validate verb=call target=roadmap.step/validate-refinement
node review verb=call target=roadmap.step/review role=reviewer
node revise verb=call target=roadmap.step/revise role=runner
node finish verb=call target=roadmap.step/finish
node out verb=out input=roadmap/RefinerFrame
wire in -> receive
wire receive -> inspect
wire inspect -> propose
wire propose -> validate
wire validate -> review when=roadmap/outcome-admissible
wire validate -> revise when=roadmap/outcome-rejected max-visits=3
wire review -> finish when=roadmap/outcome-accept
wire review -> revise when=roadmap/outcome-revise max-visits=3
wire revise -> propose max-visits=3
wire finish -> out
budget max-steps=32 max-node-visits=6 max-edge-visits=4

metadata:
profile=roadmap/refiner-v1
proposal-shape=roadmap/RefinementProposal-v1
result-shape=roadmap/RefinementResult-v1
