graph:
topology agent/phased-v1
node in verb=in output=agent/RunFrame
node gather verb=call target=agent.step/component role=component tools=[search,read]
node draft verb=call target=agent.step/model-turn role=runner tools=[compose]
node check verb=call target=agent.step/review role=reviewer tools=[lint,verify]
node finish verb=call target=agent.step/finish
node stop verb=call target=agent.step/stop
node out verb=out input=agent/RunFrame
wire in -> gather
wire gather -> draft when=agent/outcome-continue
wire gather -> stop when=agent/outcome-error
wire draft -> check when=agent/outcome-final
wire draft -> gather when=agent/outcome-tool-calls max-visits=2
wire draft -> stop when=agent/outcome-error
wire check -> finish when=agent/outcome-accept
wire check -> draft when=agent/outcome-revise max-visits=2
wire check -> stop when=agent/outcome-reject
wire check -> stop when=agent/outcome-error
wire finish -> out
wire stop -> out
budget max-steps=28 max-node-visits=7 max-edge-visits=3

metadata:
profile=agent/conduct-v1
requires-roles=[component,reviewer,runner]
result-shape=agent/RunFrame
domain-budget="gather=3 draft=3 check=3 back-edges=2"
diagram="gather -> draft -> check -> finish"

tests:
normalized input=agent/test-frame expect=agent/phased-v1
