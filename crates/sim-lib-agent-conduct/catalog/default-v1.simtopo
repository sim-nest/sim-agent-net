graph:
topology agent/default-v1
node in verb=in output=agent/RunFrame
node model verb=call target=agent.step/model-turn role=runner
node finish verb=call target=agent.step/finish
node stop verb=call target=agent.step/stop
node out verb=out input=agent/RunFrame
wire in -> model
wire model -> finish when=agent/outcome-final
wire model -> finish when=agent/outcome-tool-calls
wire model -> stop when=agent/outcome-error
wire finish -> out
wire stop -> out
budget max-steps=12 max-node-visits=4 max-edge-visits=4

metadata:
profile=agent/conduct-v1
requires-roles=[runner]
result-shape=agent/RunFrame
domain-budget="model-turns=1 tool-calls=0 revisions=0"
diagram="input -> model -> finish|stop"
compatibility="direct request and agent/start share this package"

tests:
normalized input=agent/test-frame expect=agent/default-v1
