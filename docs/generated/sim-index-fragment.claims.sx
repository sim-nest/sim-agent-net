  (primary [row Route(RouteRecord { id: RouteId("route/run-genai-locally"), title: "Run GenAI locally", audiences: ["user", "code", "framework"], steps: [Feature { id: FeatureId("feature/sim-agent-net/model-runner-framework"), why: "The runner framework supplies provider-neutral requests, process adapters, loopback HTTP profiles, and loadable model sites for local GenAI execution." }, Feature { id: FeatureId("feature/sim-agent-net/bridge-runtime"), why: "BRIDGE carries the checked model-facing packet workflow." }, Feature { id: FeatureId("feature/sim-agent-net/eval-fabric-sites"), why: "EvalFabric placement resolves the selected local model site." }, Specimen { id: SpecimenId("recipe/sim-agent-net/crates/sim-lib-agent/01-basics/genai-assembly"), why: "The assembly recipe is the reusable checked exchange run after placing the local model site." }, Specimen { id: SpecimenId("spec-test/sim-agent-net/crates/sim-lib-agent/src/tests/genai_assembly"), why: "The checked specimen runs the same recipe through fake, subprocess, loopback Ollama, native provider, and OpenAI-compatible placements." }], doc_anchor: None })] [note "route/run-genai-locally"] [section "route"])
  (primary [row Route(RouteRecord { id: RouteId("route/run-genai-with-provider"), title: "Run GenAI through a provider", audiences: ["user", "code", "framework"], steps: [Feature { id: FeatureId("feature/sim-agent-net/provider-control"), why: "Provider families and seats are one open organ with shared conformance and fan-out." }, Feature { id: FeatureId("feature/sim-agent-net/model-runner-framework"), why: "The runner framework owns HTTP provider profiles and the provider-neutral request and response contract." }, Feature { id: FeatureId("feature/sim-agent-net/bridge-runtime"), why: "BRIDGE keeps provider calls inside checked ASK packets and output validation." }, Specimen { id: SpecimenId("spec-test/sim-agent-net/crates/sim-lib-bridge/src/tests/ask"), why: "The checked ASK specimen validates the exchange contract provider runners answer." }, Specimen { id: SpecimenId("recipe/sim-agent-net/crates/sim-lib-agent/01-basics/genai-assembly"), why: "The assembly recipe stays backend-neutral while the host places the provider target." }, Specimen { id: SpecimenId("spec-test/sim-agent-net/crates/sim-lib-agent/src/tests/genai_assembly"), why: "The checked specimen runs that recipe through OpenAI, Anthropic, and OpenAI-compatible provider placements with replacement and capability checks." }], doc_anchor: None })] [note "route/run-genai-with-provider"] [section "route"])
  (primary [row Route(RouteRecord { id: RouteId("route/run-local-roadmap"), title: "Run, inspect, recover, or replay one local roadmap execution without delivery authority", audiences: ["framework"], steps: [Feature { id: FeatureId("feature/sim-agent-net/loadable-local-roadmap-runner"), why: "The loaded service checks the explicit Shapes and content identities before dispatch and retains the selected generation through acknowledgement." }, Specimen { id: SpecimenId("spec-test/sim-agent-net/crates/sim-lib-roadmap-runner/src/local_command"), why: "The focused tests prove the verb allowlist, mutation gate, identity-complete receipts, replay, and generation retention." }], doc_anchor: None })] [note "route/run-local-roadmap"] [section "route"])
  (primary [row Route(RouteRecord { id: RouteId("route/serve-over-mcp"), title: "Serve over MCP", audiences: ["user", "code"], steps: [Feature { id: FeatureId("feature/sim-agent-net/mcp-server"), why: "The MCP row owns the command surface and loaded server libraries." }, Specimen { id: SpecimenId("recipe/sim-agent-net/crates/sim-mcp-server/01-basics/final-stack"), why: "The final product recipe routes stdio, authenticated HTTP, compatibility, protected state, subscriptions, cancellation, shared Table, and extensions through one composition." }], doc_anchor: None })] [note "route/serve-over-mcp"] [section "route"])
